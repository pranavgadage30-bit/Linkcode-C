#include<stdio.h>
int main(){
    int n = 10;
    int *ptr;
    
    ptr=&n;
    
    printf("\nValue of n is: %d", n);
    printf("\nAddress of n is: %u", &n);
    printf("\n--------------------------------------");
    printf("\nValue of n is using pointer : %d", *ptr);
    printf("\nAddress of n using pointer : %u", ptr);
}
